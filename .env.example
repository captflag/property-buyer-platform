# ============================================================================
# Property Buyer Platform -- environment
#
# Every value here is OPTIONAL. With none of them set the app boots into a
# fully populated demonstration mode, which is how it is meant to be explored
# for the first time. Add Supabase to turn on real accounts, storage and
# realtime; add an Anthropic key to turn on the natural-language assistant.
# ============================================================================

# ---- Supabase --------------------------------------------------------------
# From your project's API settings. Running `supabase start` locally prints
# these for the local stack.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses row-level security entirely -- used for seeding and
# scheduled jobs, never in a request that renders data for a user.
# Never expose this to the browser and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI assistant ----------------------------------------------------------
# Without this the assistant falls back to a built-in responder that reads the
# same project records. It stays useful; it just is not conversational.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Scheduled jobs and email ----------------------------------------------
# Protects /api/cron/* -- the weekly digest. Vercel Cron sends it on its own as
# "Authorization: Bearer <secret>"; any other scheduler must send the same.
# At least 16 characters. Without it, scheduled jobs are switched off.
CRON_SECRET=

# Email for the weekly digest, through Resend (https://resend.com). Without
# both, the scheduler does a dry run: it works out who would be emailed and
# sends nothing. The sender looks like: Kestrel <digest@your-domain.com>
RESEND_API_KEY=
DIGEST_FROM_EMAIL=

# ---- Deployment ------------------------------------------------------------
# Used to build auth callback URLs. Must match the deployed origin exactly,
# and must be registered in Supabase's allowed redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
